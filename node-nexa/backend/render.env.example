# Template environment variables untuk Render Web Service.
# Jangan isi credential asli di file ini atau commit file rahasia ke GitHub.

NODE_ENV=production
PORT=10000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/nueva?retryWrites=true&w=majority
MONGODB_DB_NAME=nueva
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=15m
CLIENT_URL=https://<frontend-vercel-domain>
GOLD_API_KEY=<optional-gold-api-key>
DNS_SERVERS=1.1.1.1,8.8.8.8
